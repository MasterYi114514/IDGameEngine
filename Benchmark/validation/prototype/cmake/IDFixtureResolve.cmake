# 从 plugin.json + profile.json 解析本产品的组装关系，并生成 C++ 侧可读的构建证据
#
# 作用（计划书 4.2 / 8.2 / 8.5）：
#   1. 读取完整 catalog，做 schema 与名字唯一性预检；
#   2. 按 profile 的显式选中集合，为每个需求解析唯一 provider（0 个 -> MissingProvider，
#      多个 -> AmbiguousProvider，绝不按顺序挑一个）；
#   3. 生成 C++ 头：catalog 声明、选中身份数组、逐需求 provider 与真实链接边证据；
#   4. 返回接线记录，由 CMakeLists 接到真实 target_link_libraries 与 PUBLIC 身份宏上。
#
# 不在这里做的事：
#   - 不做拓扑排序（计划书 8.5：C++ 侧重新推导并产出最终顺序）；
#   - 不做能力/槽位唯一性（P0 范围外，P1/P2 再补）；
#   - 不读取任何机器绝对路径写进生成物。
include_guard()

# 把 target 名规范化成身份宏 token：大写，非字母数字变下划线
function(id_fixture_target_token TARGET OUT_VAR)
    string(TOUPPER "${TARGET}" upper)
    string(REGEX REPLACE "[^A-Z0-9]" "_" token "${upper}")
    set(${OUT_VAR} "${token}" PARENT_SCOPE)
endfunction()

# id_fixture_resolve(
#     CATALOG <manifest...>
#     PROFILE <profile.json>
#     GENERATED_DIR <dir>
#     HEADER_NAME <name.hpp>
#     OUT_PREFIX <前缀，用于回传结果变量>)
function(id_fixture_resolve)
    cmake_parse_arguments(R "" "PROFILE;GENERATED_DIR;HEADER_NAME;OUT_PREFIX" "CATALOG" ${ARGN})

    if(NOT R_PROFILE OR NOT R_CATALOG OR NOT R_GENERATED_DIR OR NOT R_HEADER_NAME OR NOT R_OUT_PREFIX)
        message(FATAL_ERROR "id_fixture_resolve: CATALOG/PROFILE/GENERATED_DIR/HEADER_NAME/OUT_PREFIX 均为必填")
    endif()

    # ---------------- 读取完整 catalog ----------------
    set(catalog_names "")
    set(catalog_targets "")
    set(catalog_index -1)

    # 清单与 profile 都是本函数的输入：加入 configure 依赖后，改 JSON 会自动重新配置
    foreach(manifest IN LISTS R_CATALOG)
        if(NOT EXISTS "${manifest}")
            message(FATAL_ERROR "catalog 清单不存在：${manifest}")
        endif()
        set_property(DIRECTORY APPEND PROPERTY CMAKE_CONFIGURE_DEPENDS "${manifest}")
    endforeach()
    if(NOT EXISTS "${R_PROFILE}")
        message(FATAL_ERROR "profile 不存在：${R_PROFILE}")
    endif()
    set_property(DIRECTORY APPEND PROPERTY CMAKE_CONFIGURE_DEPENDS "${R_PROFILE}")

    foreach(manifest IN LISTS R_CATALOG)
        file(READ "${manifest}" json)

        string(JSON schema ERROR_VARIABLE json_error GET "${json}" schema_version)
        if(json_error)
            message(FATAL_ERROR "清单缺少 schema_version：${manifest}")
        endif()
        if(NOT schema STREQUAL "1")
            message(FATAL_ERROR "不支持的 schema_version=${schema}：${manifest}")
        endif()

        foreach(field name target namespace kind version provides lifecycle)
            string(JSON ${field} ERROR_VARIABLE json_error GET "${json}" ${field})
            if(json_error)
                message(FATAL_ERROR "清单缺少字段 ${field}：${manifest}")
            endif()
        endforeach()

        list(FIND catalog_names "${name}" duplicate)
        if(duplicate GREATER -1)
            message(FATAL_ERROR "catalog 内重名插件：${name}（${manifest}）")
        endif()

        math(EXPR catalog_index "${catalog_index} + 1")
        list(APPEND catalog_names "${name}")
        list(APPEND catalog_targets "${target}")
        set(IDF_CAT_${catalog_index}_NAME    "${name}")
        set(IDF_CAT_${catalog_index}_TARGET  "${target}")
        set(IDF_CAT_${catalog_index}_KIND    "${kind}")
        set(IDF_CAT_${catalog_index}_LIFECYCLE "${lifecycle}")

        string(JSON dep_count LENGTH "${json}" dependencies)
        set(IDF_CAT_${catalog_index}_GROUP_COUNT ${dep_count})
        if(dep_count GREATER 0)
            math(EXPR dep_last "${dep_count} - 1")
            foreach(group RANGE 0 ${dep_last})
                string(JSON candidate_count LENGTH "${json}" dependencies ${group})
                set(candidates "")
                if(candidate_count GREATER 0)
                    math(EXPR candidate_last "${candidate_count} - 1")
                    foreach(candidate RANGE 0 ${candidate_last})
                        string(JSON leaf GET "${json}" dependencies ${group} ${candidate})
                        list(APPEND candidates "${leaf}")
                    endforeach()
                endif()
                set(IDF_CAT_${catalog_index}_GROUP_${group} "${candidates}")
            endforeach()
        endif()
    endforeach()
    list(LENGTH catalog_names catalog_count)

    # ---------------- 读取 profile ----------------
    file(READ "${R_PROFILE}" profile)
    string(JSON profile_schema ERROR_VARIABLE json_error GET "${profile}" schema_version)
    if(json_error OR NOT profile_schema STREQUAL "1")
        message(FATAL_ERROR "profile schema 非法：${R_PROFILE}")
    endif()
    string(JSON enabled_count LENGTH "${profile}" enabled_plugins)

    set(enabled_indices "")
    foreach(i RANGE 0 255)
        if(i GREATER_EQUAL enabled_count)
            break()
        endif()
        string(JSON enabled_name GET "${profile}" enabled_plugins ${i})
        list(FIND catalog_names "${enabled_name}" position)
        if(position LESS 0)
            message(FATAL_ERROR "profile 选中了 catalog 之外的名字：${enabled_name}")
        endif()
        list(FIND enabled_indices "${position}" already)
        if(already GREATER -1)
            message(FATAL_ERROR "profile 重复启用：${enabled_name}")
        endif()
        list(APPEND enabled_indices "${position}")
    endforeach()

    set(enabled_names "")
    foreach(index IN LISTS enabled_indices)
        list(APPEND enabled_names "${IDF_CAT_${index}_NAME}")
    endforeach()

    # ---------------- 逐需求解析唯一 provider ----------------
    set(bindings "")
    set(edges "")
    set(wiring "")
    foreach(dependent_index IN LISTS enabled_indices)
        set(group_count ${IDF_CAT_${dependent_index}_GROUP_COUNT})
        set(seen_providers "")
        if(group_count GREATER 0)
            math(EXPR group_last "${group_count} - 1")
            foreach(group RANGE 0 ${group_last})
                set(matches "")
                foreach(candidate IN LISTS IDF_CAT_${dependent_index}_GROUP_${group})
                    if(candidate STREQUAL IDF_CAT_${dependent_index}_NAME)
                        message(FATAL_ERROR "依赖白名单包含自身：${candidate}")
                    endif()
                    list(FIND enabled_names "${candidate}" position)
                    if(position GREATER -1)
                        list(APPEND matches "${candidate}")
                    endif()
                endforeach()
                list(LENGTH matches match_count)
                if(match_count EQUAL 0)
                    message(FATAL_ERROR "MissingProvider: ${IDF_CAT_${dependent_index}_NAME} 的需求组 ${group} 在选中集合内没有候选")
                endif()
                if(match_count GREATER 1)
                    message(FATAL_ERROR "AmbiguousProvider: ${IDF_CAT_${dependent_index}_NAME} 的需求组 ${group} 命中 ${match_count} 个候选：${matches}")
                endif()
                set(provider_name "${matches}")
                list(FIND catalog_names "${provider_name}" provider_index)
                list(APPEND bindings "${dependent_index}|${provider_index}|${group}")
                list(FIND seen_providers "${provider_name}" seen)
                if(seen LESS 0)
                    list(APPEND seen_providers "${provider_name}")
                    list(APPEND edges "${provider_index}|${dependent_index}")
                endif()
                id_fixture_target_token("${IDF_CAT_${provider_index}_TARGET}" provider_token)
                list(APPEND wiring "${IDF_CAT_${dependent_index}_TARGET}|${IDF_CAT_${provider_index}_TARGET}|${provider_token}")
            endforeach()
        endif()
    endforeach()

    list(LENGTH bindings binding_count)
    list(LENGTH edges edge_count)
    list(LENGTH enabled_indices selected_count)

    # ---------------- 生成 C++ 头 ----------------
    set(header "// 本文件由 cmake/IDFixtureResolve.cmake 依据 plugin.json + profile.json 生成，勿手改\n")
    string(APPEND header "#pragma once\n\n")
    string(APPEND header "#include <array>\n#include <cstddef>\n#include <string_view>\n#include <tuple>\n\n")
    string(APPEND header "#include \"FixturePluginApi.hpp\"\n\n")
    string(APPEND header "namespace ID::Bench::Fixture::Generated\n{\n")

    string(APPEND header "    inline constexpr std::size_t kCatalogCount      = ${catalog_count};\n")
    string(APPEND header "    inline constexpr std::size_t kSelectedCount     = ${selected_count};\n")
    string(APPEND header "    inline constexpr std::size_t kBindingCount      = ${binding_count};\n")
    string(APPEND header "    inline constexpr std::size_t kEdgeCount         = ${edge_count};\n\n")

    # 每个 catalog 条目的名字与需求组（组长度可不等，因此用 tuple 而不是矩形数组）
    foreach(index RANGE 0 255)
        if(index GREATER_EQUAL catalog_count)
            break()
        endif()
        string(APPEND header "    inline constexpr char kCatalogName${index}[] = \"${IDF_CAT_${index}_NAME}\";\n")
        string(APPEND header "    inline constexpr std::size_t kCatalogRequirementCount${index} = ${IDF_CAT_${index}_GROUP_COUNT};\n")
        set(group_count ${IDF_CAT_${index}_GROUP_COUNT})
        if(group_count EQUAL 0)
            string(APPEND header "    inline constexpr std::tuple<> kCatalogGroups${index} = {};\n")
        endif()
        if(group_count GREATER 0)
            math(EXPR group_last "${group_count} - 1")
            set(group_names "")
            foreach(group RANGE 0 ${group_last})
                set(candidates "${IDF_CAT_${index}_GROUP_${group}}")
                list(LENGTH candidates candidate_count)
                string(APPEND header "    inline constexpr std::array<std::string_view, ${candidate_count}> kCatalogGroup${index}_${group} = {")
                set(separator " ")
                foreach(candidate IN LISTS candidates)
                    string(APPEND header "${separator}\"${candidate}\"")
                    set(separator ", ")
                endforeach()
                string(APPEND header " };\n")
                list(APPEND group_names "kCatalogGroup${index}_${group}")
            endforeach()
            string(REPLACE ";" ", " group_names_joined "${group_names}")
            string(APPEND header "    inline constexpr auto kCatalogGroups${index} = std::tuple{ ${group_names_joined} };\n")
        endif()
    endforeach()

    # catalog 构造：生产路径同样由生成器产出，不手写第二份 manifest
    string(APPEND header "\n    consteval auto make_catalog() noexcept\n    {\n        return std::tuple{\n")
    foreach(index RANGE 0 255)
        if(index GREATER_EQUAL catalog_count)
            break()
        endif()
        string(APPEND header "            declare_dependencies(register_plugin(kCatalogName${index}), kCatalogGroups${index}),\n")
    endforeach()
    string(APPEND header "        };\n    }\n\n")

    # 选中身份数组：0 个选中时也是显式给出元素类型与数量的空数组
    if(selected_count EQUAL 0)
        string(APPEND header "    inline constexpr std::array<PluginIdentity, 0> kSelected = {};\n")
    else()
        string(APPEND header "    inline constexpr std::array<PluginIdentity, ${selected_count}> kSelected = {")
        set(separator " ")
        foreach(index IN LISTS enabled_indices)
            string(APPEND header "${separator}register_plugin(kCatalogName${index})")
            set(separator ", ")
        endforeach()
        string(APPEND header " };\n")
    endif()

    # 构建证据：选中集合 / 逐需求 provider / 真实链接边
    string(APPEND header "\n")
    set(binding_index 0)
    foreach(record IN LISTS bindings)
        string(REPLACE "|" ";" parts "${record}")
        list(GET parts 0 dependent_index)
        list(GET parts 1 provider_index)
        list(GET parts 2 group)
        string(APPEND header "    inline constexpr char     kBinding${binding_index}Dependent[]   = \"${IDF_CAT_${dependent_index}_NAME}\";\n")
        string(APPEND header "    inline constexpr char     kBinding${binding_index}Provider[]    = \"${IDF_CAT_${provider_index}_NAME}\";\n")
        string(APPEND header "    inline constexpr std::size_t kBinding${binding_index}Requirement = ${group};\n")
        math(EXPR binding_index "${binding_index} + 1")
    endforeach()
    set(edge_index 0)
    foreach(record IN LISTS edges)
        string(REPLACE "|" ";" parts "${record}")
        list(GET parts 0 provider_index)
        list(GET parts 1 dependent_index)
        string(APPEND header "    inline constexpr char kEdge${edge_index}From[] = \"${IDF_CAT_${provider_index}_NAME}\";\n")
        string(APPEND header "    inline constexpr char kEdge${edge_index}To[]   = \"${IDF_CAT_${dependent_index}_NAME}\";\n")
        math(EXPR edge_index "${edge_index} + 1")
    endforeach()

    string(APPEND header "\n    // 证据对象在编译期构造，不产生运行期全局构造\n")
    string(APPEND header "    inline constexpr auto kEvidence = []\n    {\n")
    string(APPEND header "        AssemblyEvidence<kSelectedCount, kBindingCount, kEdgeCount> evidence{};\n")
    string(APPEND header "        evidence.selected_count = kSelectedCount;\n")
    set(selected_write 0)
    foreach(index IN LISTS enabled_indices)
        string(APPEND header "        evidence.selected_names[${selected_write}] = kCatalogName${index};\n")
        math(EXPR selected_write "${selected_write} + 1")
    endforeach()
    string(APPEND header "        evidence.binding_count = kBindingCount;\n")
    foreach(index RANGE 0 255)
        if(index GREATER_EQUAL binding_count)
            break()
        endif()
        string(APPEND header "        evidence.bindings[${index}].dependent   = kBinding${index}Dependent;\n")
        string(APPEND header "        evidence.bindings[${index}].provider     = kBinding${index}Provider;\n")
        string(APPEND header "        evidence.bindings[${index}].requirement  = kBinding${index}Requirement;\n")
    endforeach()
    string(APPEND header "        evidence.edge_count = kEdgeCount;\n")
    foreach(index RANGE 0 255)
        if(index GREATER_EQUAL edge_count)
            break()
        endif()
        string(APPEND header "        evidence.edges[${index}].from = kEdge${index}From;\n")
        string(APPEND header "        evidence.edges[${index}].to   = kEdge${index}To;\n")
    endforeach()
    string(APPEND header "        return evidence;\n    }();\n")
    string(APPEND header "} // namespace ID::Bench::Fixture::Generated\n")

    # 用模板 + configure_file 落盘：内容不变时不刷新时间戳（计划书 8.4），
    # 也不再由 file(WRITE) 直接产出最终头文件
    set(IDF_GENERATED_BODY "${header}")
    configure_file("${IDF_TEMPLATE_DIR}/Assembly.generated.hpp.in"
                   "${R_GENERATED_DIR}/${R_HEADER_NAME}"
                   @ONLY)

    # ---------------- 回传结果 ----------------
    set(${R_OUT_PREFIX}_WIRING          "${wiring}"          PARENT_SCOPE)
    set(${R_OUT_PREFIX}_SELECTED_NAMES   "${enabled_names}"   PARENT_SCOPE)
    set(${R_OUT_PREFIX}_CATALOG_NAMES    "${catalog_names}"   PARENT_SCOPE)
    set(${R_OUT_PREFIX}_CATALOG_TARGETS  "${catalog_targets}" PARENT_SCOPE)
    set(${R_OUT_PREFIX}_SELECTED_TARGETS ""                    PARENT_SCOPE)
    foreach(index IN LISTS enabled_indices)
        set(selected_targets "${${R_OUT_PREFIX}_SELECTED_TARGETS}")
        list(APPEND selected_targets "${IDF_CAT_${index}_TARGET}")
        set(${R_OUT_PREFIX}_SELECTED_TARGETS "${selected_targets}" PARENT_SCOPE)
    endforeach()
endfunction()
