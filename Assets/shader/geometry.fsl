#version 440 core

out vec4 FragColor;

in vec2 v_uv;
in vec3 v_world_pos;
in vec3 v_normal;

uniform sampler2D texture_sampler;

uniform vec3  u_color;           // 材质颜色调制
uniform vec3  u_camera_pos;      // 相机位置（高光用）
uniform vec3  u_ambient;

uniform int   u_light_count;
uniform vec3  u_light_dirs[8];
uniform vec3  u_light_positions[8];
uniform vec3  u_light_colors[8];

// ── ★ Phase 4 阴影支持（由 RenderPass::apply_shadow 设置）──
uniform sampler2D u_shadow_map;          // 阴影深度贴图（ShadowPass 产出，slot 1）
uniform mat4      u_light_space_mvp;     // 主方向光 VP 矩阵
uniform int       u_shadow_enabled;      // 0 = 本帧无阴影（跳过阴影计算）
uniform float     u_shadow_bias;         // 深度偏移（防止自阴影）
uniform int       u_shadow_pcf_radius;   // PCF 采样半径（0→1×1, 1→3×3, 2→5×5, 3→7×7）

// PCF 软阴影：返回 0.0（全阴影）~ 1.0（全亮）
float compute_shadow(vec3 world_pos)
{
    if (u_shadow_enabled == 0)
    {
        return 1.0;
    }

    // 世界坐标 → 光源裁剪空间 → [0,1] 纹理坐标
    vec4 shadow_coord = u_light_space_mvp * vec4(world_pos, 1.0);
    vec3 proj = shadow_coord.xyz * 0.5 + 0.5;

    // 深度偏移：缓解阴影痤疮（acne）
    proj.z -= u_shadow_bias;

    // 超出阴影贴图覆盖范围 → 视为不在阴影中（亮）
    if (proj.x < 0.0 || proj.x > 1.0 || proj.y < 0.0 || proj.y > 1.0 || proj.z < 0.0 || proj.z > 1.0)
    {
        return 1.0;
    }

    int radius = u_shadow_pcf_radius;
    float shadow = 0.0;
    float sample_count = 0.0;
    vec2 texel = 1.0 / vec2(textureSize(u_shadow_map, 0));
    for (int x = -radius; x <= radius; ++x)
    {
        for (int y = -radius; y <= radius; ++y)
        {
            float depth = texture(u_shadow_map, proj.xy + vec2(float(x), float(y)) * texel).r;
            shadow += (proj.z < depth) ? 1.0 : 0.0;
            sample_count += 1.0;
        }
    }
    return shadow / sample_count;
}

void main()
{
    vec4 tex_color = texture(texture_sampler, v_uv);
    vec3 base_color = tex_color.rgb * u_color;
    vec3 N = normalize(v_normal);

    // 环境光
    vec3 result = u_ambient * base_color;

    for (int i = 0; i < u_light_count; ++i)
    {
        // 平行光使用方向，点/聚光灯用位置推算方向
        vec3 L;
        if (u_light_dirs[i] != vec3(0.0))
        {
            L = normalize(-u_light_dirs[i]);
        }
        else
        {
            L = normalize(u_light_positions[i] - v_world_pos);
        }

        // 漫反射（平行光乘阴影系数，点/聚光灯暂不投射阴影）
        float diff = max(dot(N, L), 0.0);
        float shadow = (u_light_dirs[i] != vec3(0.0)) ? compute_shadow(v_world_pos) : 1.0;
        result += u_light_colors[i] * diff * base_color * shadow;

        // 简单 Blinn-Phong 高光
        vec3 V = normalize(u_camera_pos - v_world_pos);
        vec3 H = normalize(L + V);
        float spec = pow(max(dot(N, H), 0.0), 32.0);
        result += u_light_colors[i] * spec * 0.3;
    }

    FragColor = vec4(result, 1.0);
}
