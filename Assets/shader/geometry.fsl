#version 440 core
out vec4 FragColor;

in vec2 uv;
in vec3 normal;

uniform sampler2D texture_sampler;

// 输入端保证了光线方向是单位向量
uniform vec3 light_dir;
uniform vec3 light_color;

void main()
{
    vec3 object_color = texture(texture_sampler, uv).rgb;

    // 漫反射相关数据
    float diffuse = clamp(dot(normal, -light_dir), 0.0, 1.0);
    vec3 diffuse_color = diffuse * light_color * object_color;

    FragColor = vec4(diffuse_color, 1.0);
}