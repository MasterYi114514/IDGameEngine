#version 440 core

// ============================================================================
//  SkyboxPass 片段着色器
//  支持两种模式（u_use_cubemap 切换）：
//    0 = 程序化渐变天空（顶/地平线/底三色插值 + 太阳高光），零资产
//    1 = cubemap 纹理采样（需要 IDRenderer cubemap 增强）
// ============================================================================

in vec3 v_dir;
out vec4 FragColor;

uniform int   u_use_cubemap;        // 0 = 程序化, 1 = cubemap
uniform samplerCube u_cubemap;

uniform vec3  u_top_color;          // 天顶色
uniform vec3  u_horizon_color;      // 地平线色
uniform vec3  u_bottom_color;       // 地面色（地平线以下）
uniform vec3  u_sun_dir;            // 太阳方向（朝向光源）
uniform float u_sun_intensity;      // 太阳亮度

void main()
{
    vec3 dir = normalize(v_dir);

    if (u_use_cubemap == 1)
    {
        FragColor = vec4(texture(u_cubemap, dir).rgb, 1.0);
        return;
    }

    // 天顶色与地面色渐变
    float t = clamp(dir.y * 0.5 + 0.5, 0.0, 1.0);
    vec3 col = mix(u_horizon_color, u_top_color, pow(t, 0.6));
    if (dir.y < 0.0)
    {
        col = mix(u_horizon_color, u_bottom_color, pow(-dir.y, 0.6));
    }

    // 太阳高光：方向点积的 512 次幂，形成锐利光晕
    float sun = pow(max(dot(dir, normalize(u_sun_dir)), 0.0), 512.0);
    col += u_sun_intensity * sun;

    FragColor = vec4(col, 1.0);
}
