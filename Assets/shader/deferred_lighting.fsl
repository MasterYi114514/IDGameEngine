#version 440 core

// ============================================================================
//  LightingPass 片段着色器（延迟渲染光照阶段）
//  采样 G-Buffer 三个附件重组 per-pixel 输入，光照/阴影公式与 geometry.fsl
//  （前向路径）逐段一致，保证两路径画面互为基准：
//    u_gbuffer_albedo  (slot 0) : rgb = albedo，a = ambient_strength
//    u_gbuffer_pos     (slot 1) : xyz = WorldPos，a = spec_strength
//    u_gbuffer_normal  (slot 2) : xyz = Normal，a = shininess
//    u_shadow_map      (slot 3) : ShadowPass 深度贴图
//  光源上限 MAX_LIGHTS = 32（前向为 8），与 LightingPass.hpp 的常量一一对应。
// ============================================================================

out vec4 FragColor;

in vec2 v_uv;

uniform sampler2D u_gbuffer_albedo;      // G-Buffer RT0（slot 0）
uniform sampler2D u_gbuffer_pos;         // G-Buffer RT1（slot 1）
uniform sampler2D u_gbuffer_normal;      // G-Buffer RT2（slot 2）

uniform vec3  u_camera_pos;      // 相机位置
uniform vec3  u_ambient;

uniform int   u_light_count;
uniform vec3  u_light_dirs[32];
uniform vec3  u_light_positions[32];
uniform vec3  u_light_colors[32];

uniform sampler2D u_shadow_map;          // 阴影深度贴图（ShadowPass 产出，slot 3）
uniform mat4      u_light_space_mvp;     // 主方向光 VP 矩阵
uniform int       u_shadow_enabled;      // 0 = 本帧无阴影（跳过阴影计算）
uniform float     u_shadow_bias;         // 深度偏移（防止自阴影）
uniform int       u_shadow_pcf_radius;   // PCF 采样半径（0→1×1, 1→3×3, 2→5×5, 3→7×7）
uniform int       u_shadow_light_index;  // 主方向光在光源数组中的下标（-1 表示无阴影）

uniform float     u_light_size;         // 光源尺寸（用于 PCSS 半影宽度计算）

vec3 calc_ambient(float strength, vec3 light_color)
{
    return strength * light_color;
}

vec3 calc_diffuse(vec3 normal, vec3 light_dir, float kd, vec3 light_color)
{
    float diff = max(dot(normal, light_dir), 0.0);
    return diff * kd * light_color;
}

vec3 calc_spec_phong(vec3 normal, vec3 light_dir, vec3 view_dir, float ks, float shininess, vec3 light_color)
{
    vec3 reflect_dir = reflect(-light_dir, normal);
    float spec = pow(max(dot(view_dir, reflect_dir), 0.0), shininess);
    return spec * ks * light_color;
}

vec3 calc_spec_blinn_phong(vec3 normal, vec3 light_dir, vec3 view_dir, float ks, float shininess, vec3 light_color)
{
    vec3 half_dir = normalize(light_dir + view_dir);
    float spec = pow(max(dot(normal, half_dir), 0.0), shininess);
    return spec * ks * light_color;
}

// 遮挡物搜索
float find_blocker_depth(sampler2D shadow_map, vec2 uv, int radius, float cur_depth)
{
    float blocker_depth_sum = 0.0;
    int blocker_count = 0;

    // 获取纹理大小，计算每个像素的偏移量
    vec2 texel_size = 1.0 / vec2(textureSize(shadow_map, 0)); 

    // 方形邻域采样
    for(int x = -radius; x <= radius; ++x)
    {
        for(int y = -radius; y <= radius; ++y)
        {
            vec2 offset = vec2(float(x), float(y)) * texel_size;    // 计算偏移量
            float depth = texture(shadow_map, uv + offset).r;  // shadow_map 里获取深度值

            if(depth < cur_depth) // 采样深度小于当前深度，说明有遮挡物
            {
                blocker_depth_sum += depth;
                blocker_count++;
            }
        }
    }

    return blocker_count > 0 ? blocker_depth_sum / float(blocker_count) : 1.0;
}

// PCF：返回 0.0（全阴影）~ 1.0（全亮）
float compute_shadow_pcf(vec3 world_pos)
{
    if (u_shadow_enabled == 0)
    {
        return 1.0;
    }

    // 世界坐标 → 光源裁剪空间 → [0,1] 纹理坐标
    vec4 shadow_coord = u_light_space_mvp * vec4(world_pos, 1.0);
    vec3 proj = shadow_coord.xyz * 0.5 + 0.5;

    // 深度偏移
    proj.z -= u_shadow_bias;

    // 超出阴影贴图覆盖范围 → 视为不在阴影中（亮）
    if (proj.x < 0.0 || proj.x > 1.0 || proj.y < 0.0 || proj.y > 1.0 || proj.z < 0.0 || proj.z > 1.0)
    {
        return 1.0;
    }

    // PCF 采样
    int radius = u_shadow_pcf_radius;
    float shadow = 0.0;
    int samples = 0;
    for(int x = -radius; x <= radius; ++x)
    {
        for(int y = -radius; y <= radius; ++y)
        {
            vec2 texel_size = 1.0 / vec2(textureSize(u_shadow_map, 0));
            vec2 offset = vec2(float(x), float(y)) * texel_size;
            float depth = texture(u_shadow_map, proj.xy + offset).r;

            if(depth < proj.z) // 当前像素在阴影中
            {
                shadow += 1.0;
            }
            samples++;
        }
    }
    return samples > 0 ? 1 - (shadow / float(samples)) : 0.0;
}

// PCSS：
float compute_shadow_pcss(vec3 world_pos)
{
    vec4 light_space_pos = u_light_space_mvp * vec4(world_pos, 1.0);
    vec3 proj = light_space_pos.xyz * 0.5 + 0.5;

    // 深度偏移
    proj.z -= u_shadow_bias;

    // 超出阴影贴图覆盖范围 → 视为不在阴影中（亮）
    if (proj.x < 0.0 || proj.x > 1.0 || proj.y < 0.0 || proj.y > 1.0 || proj.z < 0.0 || proj.z > 1.0)
    {
        return 1.0;
    }

    // 遮挡物搜索
    int radius = 20;
    float blocker_depth = find_blocker_depth(u_shadow_map, proj.xy, radius, proj.z);

    // 没有遮挡物，则直接返回 1.0（全亮）
    if (blocker_depth >= 1.0)
    {
        return 1.0;
    }

    // 计算半影宽度
    float penumbra_width = (proj.z - blocker_depth) / blocker_depth * u_light_size;

    // 根据半影宽度做 pcf
    float shadow = 0.0;
    int pcf_radius = int(penumbra_width);
    float texel_size = 1.0 / float(textureSize(u_shadow_map, 0).x);

    for(int x = -pcf_radius; x <= pcf_radius; ++x)
    {
        for(int y = -pcf_radius; y <= pcf_radius; ++y)
        {
            float closest_depth = texture(u_shadow_map, proj.xy + vec2(float(x), float(y)) * texel_size).r;
            shadow += closest_depth < proj.z ? 1.0 : 0.0;
        }
    }

    float total = float((pcf_radius * 2 + 1) * (pcf_radius * 2 + 1));
    return shadow / total;
}

void main()
{
    // 从 G-Buffer 重组 per-pixel 输入（附件布局见 gbuffer.fsl 顶部注释）
    vec4 albedo_ambient = texture(u_gbuffer_albedo, v_uv);
    vec4 pos_spec       = texture(u_gbuffer_pos, v_uv);
    vec4 normal_shin    = texture(u_gbuffer_normal, v_uv);

    vec3  albedo           = albedo_ambient.rgb;
    float ambient_strength = albedo_ambient.a;
    vec3  world_pos        = pos_spec.xyz;
    float spec_strength    = pos_spec.a;
    vec3  normal           = normalize(normal_shin.xyz);
    float shininess        = normal_shin.a;

    // 环境光（与 geometry.fsl 一致：ambient * base_color）
    vec3 result = calc_ambient(ambient_strength, u_ambient) * albedo;

    for (int i = 0; i < u_light_count; ++i)
    {
        // 平行光使用方向，点/聚光灯用位置推算方向
        vec3 L;
        if (u_light_dirs[i] != vec3(0.0))
        {
            L = normalize(-u_light_dirs[i]);
        }
        else
        {
            L = normalize(u_light_positions[i] - world_pos);
        }

        // 漫反射
        vec3 diffuse = calc_diffuse(normal, L, 1.0, u_light_colors[i]);

        // 镜面反射
        vec3 specular = calc_spec_blinn_phong(normal, L, normalize(u_camera_pos - world_pos), 
            spec_strength, shininess, u_light_colors[i]);

        // 阴影（仅主方向光）
        float shadow = 1.0;
        if (i == u_shadow_light_index && u_shadow_enabled == 1)
        {
            shadow = compute_shadow_pcf(world_pos);
        }

        result += diffuse * albedo * shadow + specular;
    }

    FragColor = vec4(result, 1.0);
}
