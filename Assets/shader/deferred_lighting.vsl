#version 440 core

// ============================================================================
//  LightingPass 全屏三角形顶点着色器（延迟渲染光照阶段）
//  与 postprocess.vsl 完全一致：输入 FullscreenQuad 的 3 顶点大三角形，
//  v_uv 由顶点位置推导（aPos * 0.5 + 0.5），覆盖 [0, 2]x[0, 2]。
// ============================================================================

layout(location = 0) in vec2 aPos;

out vec2 v_uv;

void main()
{
    v_uv = aPos * 0.5 + 0.5;
    gl_Position = vec4(aPos, 0.0, 1.0);
}
