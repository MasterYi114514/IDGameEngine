#version 440 core

layout(location = 0) in vec3 aPos;
layout(location = 1) in vec2 aUV;
layout(location = 2) in vec3 aNormal;

out vec2 uv;
out vec3 normal;
out vec3 world_pos;

uniform mat4 MVP;
uniform mat4 model;
uniform mat4 view;

void main()
{
    vec4 local_pos = vec4(aPos, 1.0);
    world_pos = (MVP * local_pos).xyz;

    uv = aUV;
    normal = aNormal;
    gl_Position = MVP * vec4(aPos, 1.0);
}